# IBM Presentation Generator — environment variables
# Copy to .env and fill in your values.
# Never commit the filled-in .env file to version control.

# ── watsonx Orchestrate ───────────────────────────────────────────────────────
WATSONX_ORCHESTRATE_API_KEY=your-watsonx-orchestrate-api-key
WATSONX_ORCHESTRATE_URL=https://your-instance.watsonx.ibm.com

# ── Backend service (Flask) ───────────────────────────────────────────────────
# URL of the running backend_service.py — set in watsonx Orchestrate env vars
# so call_presentation_backend can reach it.
PPTX_BACKEND_URL=http://127.0.0.1:8080

# Shared secret: watsonx Orchestrate sends this as "Authorization: Bearer <key>"
# and the backend validates it.  Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PPTX_BACKEND_API_KEY=change-me-use-secrets-token-urlsafe-32

# ── Flask runtime ─────────────────────────────────────────────────────────────
PORT=8080
